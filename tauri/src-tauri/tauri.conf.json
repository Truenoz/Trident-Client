{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trident Client",
  "version": "1.3.0",
  "identifier": "com.novalauncher.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Trident Client",
        "width": 1440,
        "height": 880,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "visible": false,
        "decorations": false,
        "backgroundColor": "#0d0d0d",
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "copyright": "Copyright © Trident Client",
    "shortDescription": "Launcher de Minecraft",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installerHeader.bmp",
        "sidebarImage": "installerSidebar.bmp",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "licenseFile": "license.txt",
    "createUpdaterArtifacts": false,
    "resources": {
      "../ui/logo.png": "logo.png"
    },
    "category": "Game",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBGMEUxMEI0NDZFOEJDQUMKUldTc3ZPaEd0QkFPRDV1WDM1RVM3K2wyQ0dmcXByR1Y5bWFZUGZZTDAzdFEyT0hwemwrNDBYSWwK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "Trident Client"
}
